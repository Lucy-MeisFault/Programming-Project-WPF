<mah:MetroWindow x:Class="Project.CreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project"
        mc:Ignorable="d"
        Title="CreateWindow" Height="520" Width="389"
        Background="#111111">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Add Game" Foreground="White" FontSize="18"
                   FontWeight="Bold" FontFamily="Segoe UI" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Text="Title" Foreground="White" FontFamily="Segoe UI" Margin="0,0,0,4"/>
        <TextBox x:Name="txtTitle" Grid.Row="2"
                 Background="#1e2a3a" Foreground="White" BorderBrush="#2a3a4a"
                 FontFamily="Segoe UI" Padding="8,6" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="3" Text="Genre" Foreground="White" FontFamily="Segoe UI" Margin="0,0,0,4"/>
        <!--todo fix ugly -->
        <ComboBox x:Name="cmbGenre" Grid.Row="4"
          Background="#1e2a3a" Foreground="Black" BorderBrush="#2a3a4a"
          FontFamily="Segoe UI" Padding="8,6" Margin="0,0,0,12"/>

        <ComboBox x:Name="cmbPlatform" Grid.Row="6"
          Background="#1e2a3a" Foreground="Black" BorderBrush="#2a3a4a"
          FontFamily="Segoe UI" Padding="8,6" Margin="0,0,0,12"/>

        <ComboBox x:Name="cmbStatus" Grid.Row="8"
          Background="#1e2a3a" Foreground="Black" BorderBrush="#2a3a4a"
          FontFamily="Segoe UI" Padding="8,6" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="9" Text="Rating (1-10)" Foreground="White" FontFamily="Segoe UI" Margin="0,0,0,4"/>
        <TextBox x:Name="txtRating" Grid.Row="10"
                 Background="#1e2a3a" Foreground="White" BorderBrush="#2a3a4a"
                 FontFamily="Segoe UI" Padding="8,6" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="11" Text="Notes" Foreground="White" FontFamily="Segoe UI" Margin="0,0,0,4"/>
        <TextBox x:Name="txtNotes" Grid.Row="12"
                 Background="#1e2a3a" Foreground="White" BorderBrush="#2a3a4a"
                 FontFamily="Segoe UI" Padding="8,6" Margin="0,0,0,20"
                 TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>

        <StackPanel Grid.Row="13" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnCancel" Content="Cancel" Width="80" Margin="0,0,8,0"
                    Background="#2a2a2a" Foreground="White" BorderThickness="0"
                    Padding="0,6" FontFamily="Segoe UI" Cursor="Hand"
                    Click="Cancel"/>
            <Button x:Name="btnSave" Content="Save" Width="80"
                    Background="#3a5a7a" Foreground="White" BorderThickness="0"
                    Padding="0,6" FontFamily="Segoe UI" Cursor="Hand"
                    Click="Save"/>
        </StackPanel>
    </Grid>
</mah:MetroWindow>