<mah:MetroWindow x:Class="Project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        Title="MainWindow" Height="620" Width="1000"
        Background="#111111">

    <mah:MetroWindow.Resources>
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#c0c0c0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#111111"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </mah:MetroWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1e2a3a">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="16,16,16,20"
                        BorderBrush="#111111" BorderThickness="0,0,0,1">
                    <TextBlock Text="my amazing cool project" Foreground="White" FontSize="16"
                               FontWeight="Bold" FontFamily="Segoe UI"/>
                </Border>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="12,12">
                    <Button x:Name="btnExit" Content="Exit" Width="60" Margin="0,0,8,0"
                            Background="#2a2a2a" Foreground="White" BorderThickness="0"
                            Padding="0,6" FontFamily="Segoe UI" Cursor="Hand"
                            Click="Exit"/>
                    <Button x:Name="btnOptions" Content="Options" Width="76"
                            Background="#2a2a2a" Foreground="#c0c0c0" BorderThickness="0"
                            Padding="0,6" FontFamily="Segoe UI" Cursor="Hand"
                            Click="Options"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                    <Button x:Name="btnLibrary"    Content="   Library"    Style="{StaticResource SidebarButton}" Click="Library"/>
                    <Button x:Name="btnStatistics" Content="   Statistics" Style="{StaticResource SidebarButton}" Click="Stats"/>
                    <Button x:Name="btnAddGame"    Content="   Add Game"   Style="{StaticResource SidebarButton}" Click="AddGame"/>
                    <Button x:Name="btnSearch"     Content="   Search"     Style="{StaticResource SidebarButton}" Click="Search"/>
                    <Button x:Name="btnSettings"   Content="   Settings"   Style="{StaticResource SidebarButton}" Click="Settings"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Background="#111111">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="16,16,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#1e2a3a" CornerRadius="8"
                        BorderBrush="#2a3a4a" BorderThickness="1" Margin="0,0,0,196">
                    <TextBlock Text="Graph" Foreground="#444" FontSize="22"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <Border Grid.Column="2" Background="#1e2a3a" CornerRadius="8"
                        BorderBrush="#2a3a4a" BorderThickness="1" Margin="0,0,0,196">
                    <TextBlock Text="Graph" Foreground="#444" FontSize="22"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <ItemsControl Grid.Row="1" x:Name="listHry" Margin="16,0,16,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1e2a3a" CornerRadius="6" Margin="0,0,0,6"
                                BorderBrush="#2a3a4a" BorderThickness="1" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="" Foreground="#c0c0c0"
                                           FontFamily="Segoe UI" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text=""
                                           Foreground="White" FontFamily="Segoe UI" FontSize="13"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</mah:MetroWindow>