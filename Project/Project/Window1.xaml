<mah:MetroWindow x:Class="Project.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" xmlns:local="clr-namespace:Project"
                 Title="LibraryWindow" Height="620" Width="1000"
        Background="#111111"
        AllowsTransparency="True" WindowStyle="None">

    <mah:MetroWindow.Resources>
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="Black"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </mah:MetroWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1e2a3a">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="16,16,16,20"
                        BorderBrush="#111111" BorderThickness="0,0,0,1">
                    <TextBlock Text="my amazing cool project"
                               Foreground="White"
                               FontSize="16"
                               FontWeight="Bold"
                               FontFamily="Segoe UI"/>
                </Border>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="12,12">
                    <Button x:Name="btnExit"
                            Content="Exit"
                            Width="60"
                            Margin="0,0,8,0"
                            Background="#2a2a2a"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="0,6"
                            FontFamily="Segoe UI"
                            Cursor="Hand"
                            Click="Exit"/>

                    <Button x:Name="btnOptions"
                            Content="Options"
                            Width="76"
                            Background="#2a2a2a"
                            Foreground="#c0c0c0"
                            BorderThickness="0"
                            Padding="0,6"
                            FontFamily="Segoe UI"
                            Cursor="Hand"
                            Click="Options"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                    <Button x:Name="btnLibrary"    Content="   Library"    Style="{StaticResource SidebarButton}" Click="Library"/>
                    <Button x:Name="btnStatistics" Content="   Statistics" Style="{StaticResource SidebarButton}" Click="Stats"/>
                    <Button x:Name="btnAddGame"    Content="   Add Game"   Style="{StaticResource SidebarButton}" Click="AddGame"/>
                    <Button x:Name="btnSearch"     Content="   Search"     Style="{StaticResource SidebarButton}" Click="Search"/>
                    <Button x:Name="btnSettings"   Content="   Settings"   Style="{StaticResource SidebarButton}" Click="Settings"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Background="#111111" Margin="16">
            <DataGrid x:Name="dgGames"
          AutoGenerateColumns="False"
          Background="#1e2a3a"
          Foreground="White"
          BorderBrush="#2a3a4a"
          BorderThickness="1"
          RowBackground="#1e2a3a"
          AlternatingRowBackground="#1b2634"
          GridLinesVisibility="Horizontal"
          HorizontalGridLinesBrush="#2a3a4a"
          FontFamily="Segoe UI"
          FontSize="13"
          CanUserAddRows="False"
          SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Title"      Binding="{Binding Title}"       Width="*"/>
                    <DataGridComboBoxColumn Header="Genre"    Width="100"
            SelectedValueBinding="{Binding IdGenre, UpdateSourceTrigger=PropertyChanged}"
            DisplayMemberPath="Name" SelectedValuePath="Id">
                        <DataGridComboBoxColumn.ElementStyle>
                            <Style TargetType="ComboBox">
                                <Setter Property="ItemsSource" Value="{x:Static local:MainWindow.genreList}"/>
                            </Style>
                        </DataGridComboBoxColumn.ElementStyle>
                        <DataGridComboBoxColumn.EditingElementStyle>
                            <Style TargetType="ComboBox">
                                <Setter Property="ItemsSource" Value="{x:Static local:MainWindow.genreList}"/>
                            </Style>
                        </DataGridComboBoxColumn.EditingElementStyle>
                    </DataGridComboBoxColumn>
                    <DataGridComboBoxColumn Header="Platform" Width="110"
                                   SelectedValueBinding="{Binding IdPlatform, UpdateSourceTrigger=PropertyChanged}"
                                   DisplayMemberPath="Name" SelectedValuePath="Id">
                        <DataGridComboBoxColumn.ElementStyle>
                            <Style TargetType="ComboBox">
                                <Setter Property="ItemsSource" Value="{x:Static local:MainWindow.platformList}"/>
                            </Style>
                        </DataGridComboBoxColumn.ElementStyle>
                        <DataGridComboBoxColumn.EditingElementStyle>
                            <Style TargetType="ComboBox">
                                <Setter Property="ItemsSource" Value="{x:Static local:MainWindow.platformList}"/>
                            </Style>
                        </DataGridComboBoxColumn.EditingElementStyle>
                    </DataGridComboBoxColumn>
                    <DataGridComboBoxColumn Header="Status"   Width="100"
            SelectedValueBinding="{Binding IdStatus, UpdateSourceTrigger=PropertyChanged}"
            DisplayMemberPath="Name" SelectedValuePath="Id">
                        <DataGridComboBoxColumn.ElementStyle>
                            <Style TargetType="ComboBox">
                                <Setter Property="ItemsSource" Value="{x:Static local:MainWindow.statusList}"/>
                            </Style>
                        </DataGridComboBoxColumn.ElementStyle>
                        <DataGridComboBoxColumn.EditingElementStyle>
                            <Style TargetType="ComboBox">
                                <Setter Property="ItemsSource" Value="{x:Static local:MainWindow.statusList}"/>
                            </Style>
                        </DataGridComboBoxColumn.EditingElementStyle>
                    </DataGridComboBoxColumn>
                    <DataGridTextColumn Header="Rating"     Binding="{Binding Rating}"      Width="60"/>
                    <DataGridTextColumn Header="Hours"      Binding="{Binding HoursPlayed}" Width="60"/>
                    <DataGridTextColumn Header="Date Added" Binding="{Binding DateAdded, StringFormat=dd/MM/yyyy}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</mah:MetroWindow>